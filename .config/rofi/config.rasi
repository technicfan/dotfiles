configuration {
    sort: true;
    sorting-method: "fzf";
}

@theme "dmenu"

* {
    text-color: #dfbf8e;
    background-color: #282828;
    /* text-transform: lowercase; */
    font: "JetBrainsMono Nerd Font 12px";
}

window {
    padding: 3px;
}

horibox {
    orientation: horizontal;
    children: [ prompt, entry, listview, numbox];
}

numbox {
    orientation: horizontal;
    children: [num-filtered-rows, textbox-num-sep, num-rows];
    expand: false;
}

num-filtered-rows {
    margin: 2px 0 2px 3px;
}

textbox-num-sep {
    expand: false;
    str: "/";
    margin: 2px 0 2px 0;
}

num-rows {
    padding: 0 3px 0 0;
    margin: 2px 2px 2px 0;
}

prompt {
    padding: 3px 0 3px 4px;
}

numbox,
entry,
element selected {
    border: 1px;
    border-top-color: #000000;
    border-left-color: #000000;
    border-bottom-color: #555555;
    border-right-color: #555555;
}

listview {
    cycle: false;
    spacing: 8px;
    margin: 0px 0px 0px 444px;
}

entry {
    blink: false;
    cursor-width: 1px;
    margin: 0 0 0 6px;
    padding: 2px 2px 0 2px;
}

element {
    border: 1px;
    border-top-color: #555555;
    border-left-color: #555555;
    border-bottom-color: #000000;
    border-right-color: #000000;
    padding: 1px 2px;
}

element selected {
    background-color: None;
}

element-text {
    highlight: bold;
    margin: 2px;
}

